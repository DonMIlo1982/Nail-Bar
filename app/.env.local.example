# Copy this file to .env.local and fill in from Supabase:
# Connect -> App Frameworks -> Next.js (or Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older projects: NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... also works
